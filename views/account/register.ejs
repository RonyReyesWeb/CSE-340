<div class="form-container">
  <%- messages() %>

  <h1><%= title %></h1>

  <form action="/account/register" method="post">
    <label for="account_firstname">First Name:</label>
    <input type="text" name="account_firstname" id="account_firstname" required autocomplete="given-name">

    <label for="account_lastname">Last Name:</label>
    <input type="text" name="account_lastname" id="account_lastname" required autocomplete="family-name">

    <label for="account_email">Email:</label>
    <input type="email" name="account_email" id="account_email" required placeholder="Enter a valid email address" autocomplete="email">

    <label for="account_password">Password:</label>

    <div class="password-rules">
    Passwords must be at least 12 characters and contain:
    <ul>
        <li>1 number</li>
        <li>1 uppercase letter</li>
        <li>1 lowercase letter</li>
        <li>1 special character</li>
    </ul>
    </div>

    <div class="password-container">
    <input type="password" name="account_password" id="account_password" required autocomplete="new-password" pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$">
    <span class="toggle-password" id="togglePassword">👁️</spa>
    </div>

    <button type="submit">Register</button>

    <script>
    const passwordInput = document.getElementById('account_password');
    const togglePassword = document.getElementById('togglePassword');

    togglePassword.addEventListener('click', () => {
        const type = passwordInput.type === 'password' ? 'text' : 'password';
        passwordInput.type = type;
        togglePassword.textContent = type === 'password' ? '👁️' : '🙈';
    });
    </script>

  <p>Already have an account? <a href="/account/login">Login here</a></p>
</div>