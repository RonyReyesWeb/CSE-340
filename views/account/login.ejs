<div class="form-container">
  <%- messages() %>

  <h1><%= title %></h1>

  <form action="/account/login" method="post">
    <label for="account_email">Email:</label>
    <input type="email" name="account_email" id="account_email" required autocomplete="email">

    <label for="account_password">Password:</label>
    <div class="password-rules">
      Password must be at least 12 characters with:
      1 number, 1 uppercase letter, and 1 special character.
    </div>
    <input type="password" name="account_password" id="account_password" required autocomplete="current-password" pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$">

    <button type="submit">Login</button>
  </form>

  <p>Don't have an account? <a href="/account/register">Register here</a></p>
</div>