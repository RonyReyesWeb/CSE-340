<div class="form-container">
  <h1>Delete: <%= inv_make %> <%= inv_model %></h1>

  <% if (message && message.length > 0) { %>
    <p class="flash-message"><%= message %></p>
  <% } %>

  <% if (errors && errors.length > 0) { %>
    <ul class="notice">
      <% errors.forEach(error => { %>
        <li><%= error.msg %></li>
      <% }) %>
    </ul>
  <% } %>

  <p>Confirm Deletion - The delete is permanent.</p>

  <form action="/inv/delete" method="post">

    <!-- Hidden inventory ID -->
    <input type="hidden" name="inv_id" value="<%= inv_id %>">

    <!-- Make -->
    <label for="inv_make">Make:</label>
    <input type="text" name="inv_make" id="inv_make"
      value="<%= inv_make %>" readonly>

    <!-- Model -->
    <label for="inv_model">Model:</label>
    <input type="text" name="inv_model" id="inv_model"
      value="<%= inv_model %>" readonly>

    <!-- Year -->
    <label for="inv_year">Year:</label>
    <input type="number" name="inv_year" id="inv_year"
      value="<%= inv_year %>" readonly>

    <!-- Price -->
    <label for="inv_price">Price:</label>
    <input type="number" name="inv_price" id="inv_price"
      value="<%= inv_price %>" readonly>

    <!-- Submit Button -->
    <button type="submit">Delete Vehicle</button>

  </form>
</div>