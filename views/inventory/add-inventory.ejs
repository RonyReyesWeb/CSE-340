<h1>Add New Inventory Item</h1>

<% if (message && message.length > 0) { %>
  <p class="flash-message"><%= message %></p>
<% } %>

<% if (errors && errors.length > 0) { %>
  <ul class="error-messages">
    <% errors.forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
<% } %>

<form action="/inv/add-inventory" method="post" novalidate>
  <label for="inv_make">Make:</label>
  <input
    type="text"
    name="inv_make"
    id="inv_make"
    value="<%= typeof inv_make !== 'undefined' ? inv_make : '' %>"
    required>

  <label for="inv_model">Model:</label>
  <input
    type="text"
    name="inv_model"
    id="inv_model"
    value="<%= typeof inv_model !== 'undefined' ? inv_model : '' %>"
    required>

  <label for="inv_price">Price:</label>
  <input
    type="number"
    name="inv_price"
    id="inv_price"
    value="<%= typeof inv_price !== 'undefined' ? inv_price : '' %>"
    required
    min="0"
    step="0.01">

  <label for="inv_year">Year:</label>
  <input
    type="number"
    name="inv_year"
    id="inv_year"
    value="<%= typeof inv_year !== 'undefined' ? inv_year : '' %>"
    required
    min="1900"
    max="2100">

  <label for="inv_miles">Mileage:</label>
  <input
    type="number"
    name="inv_miles"
    id="inv_miles"
    value="<%= typeof inv_miles !== 'undefined' ? inv_miles : '' %>"
    required
    min="0">

  <label for="inv_image">Image URL:</label>
  <input
    type="text"
    name="inv_image"
    id="inv_image"
    value="<%= typeof inv_image !== 'undefined' ? inv_image : '/images/no-image.png' %>">

  <label for="classification_id">Classification:</label>
  <%= classificationList %>

  <button type="submit">Add Vehicle</button>
</form>