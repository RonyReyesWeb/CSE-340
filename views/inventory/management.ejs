<div class="form-container">
  <h1>Inventory Management</h1>

  <% if (message && message.length > 0) { %>
    <p class="flash-message"><%= message %></p>
  <% } %>

  <ul>
    <li><a href="/inv/add-classification">Add New Classification</a></li>
    <li><a href="/inv/add-inventory">Add New Inventory Item</a></li>
  </ul>

  <!-- Week5 assignments -->
  <h1>Manage Inventory</h1>
  <p>Select a classification from the list to see the items belonging to that classification.</p>
  <!-- Week5 assignments Classification dropdown from controller -->
  <%- classificationSelect %>
  <!-- Table where JavaScript will insert inventory items -->
  <table id="inventoryDisplay"></table>
  <!-- Message if JavaScript is disabled -->
  <noscript>
    JavaScript must be enabled to use this page.
  </noscript>
</div>

<script src="../../js/inventory.js"></script>