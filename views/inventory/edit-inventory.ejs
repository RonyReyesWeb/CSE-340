<div class="form-container">
  <h1>Edit Inventory Item: <%= inv_make %> <%= inv_model %></h1>

  <% if (message && message.length > 0) { %>
    <p class="flash-message"><%= message %></p>
  <% } %>

  <% if (errors && errors.length > 0) { %>
    <ul class="notice">
      <% errors.forEach(error => { %>
        <li><%= error.msg %></li>
      <% }) %>
    </ul>
  <% } %>

  <form action="/inv/update" method="post">
  

    <!-- Hidden inventory ID -->
    <input type="hidden" name="inv_id" value="<%= inv_id %>">

    <!-- Classification -->
    <label for="classificationList">Classification:</label>
    <%- classificationSelect %>

    <!-- Make -->
    <label for="inv_make">Make:</label>
    <input
      type="text"
      name="inv_make"
      id="inv_make"
      minlength="3"
      placeholder="Min of 3 characters"
      value="<%= typeof inv_make !== 'undefined' ? inv_make : '' %>"
      required>

    <!-- Model -->
    <label for="inv_model">Model:</label>
    <input
      type="text"
      name="inv_model"
      id="inv_model"
      minlength="3"
      placeholder="Min of 3 characters"
      value="<%= typeof inv_model !== 'undefined' ? inv_model : '' %>"
      required>

    <!-- Year -->
    <label for="inv_year">Year:</label>
    <input
      type="number"
      name="inv_year"
      id="inv_year"
      placeholder="4-digit year"
      min="1900"
      max="2099"
      value="<%= typeof inv_year !== 'undefined' ? inv_year : '' %>"
      required>

    <!-- Description -->
    <label for="inv_description">Description:</label>
    <textarea
      name="inv_description"
      id="inv_description"
      required><%= typeof inv_description !== 'undefined' ? inv_description : '' %></textarea>

    <!-- Image Path -->
    <label for="inv_image">Image Path:</label>
    <input
      type="text"
      name="inv_image"
      id="inv_image"
      value="<%= typeof inv_image !== 'undefined' ? inv_image : '/images/no-image.png' %>">

    <!-- Thumbnail Path -->
    <label for="inv_thumbnail">Thumbnail Path:</label>
    <input
      type="text"
      name="inv_thumbnail"
      id="inv_thumbnail"
      value="<%= typeof inv_thumbnail !== 'undefined' ? inv_thumbnail : '/images/no-image.png' %>">

    <!-- Price -->
    <label for="inv_price">Price:</label>
    <input
      type="number"
      name="inv_price"
      id="inv_price"
      placeholder="decimal or integer"
      required
      value="<%= typeof inv_price !== 'undefined' ? inv_price : '' %>">

    <!-- Miles -->
    <label for="inv_miles">Mileage:</label>
    <input
      type="number"
      name="inv_miles"
      id="inv_miles"
      placeholder="Digits only"
      value="<%= typeof inv_miles !== 'undefined' ? inv_miles : '' %>"
      required>

    <!-- Color -->
    <label for="inv_color">Color:</label>
    <input
      type="text"
      name="inv_color"
      id="inv_color"
      required
      value="<%= typeof inv_color !== 'undefined' ? inv_color : '' %>">

    <!-- Submit Button -->
    <button type="submit">Update Vehicle</button>

  </form>
</div>