<header id="top-header">
  <span class="siteName">
    <a href="/" title="Return to home page">CSE Motors</a>
  </span>
  <div id="tools">
    <% if (loggedin) { %>
      <span class="welcome-msg">
        Welcome, <%= accountData.account_firstname %>!
      </span>
      <a title="Go to your account" href="/account/">My Account</a>
    <% } else { %>
      <a href="/account/login">Login</a>
    <% } %>
  </div>
</header>